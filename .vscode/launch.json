{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Convertir VDF en XML",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/convert-vdf-to-xml.js",
            "args": [
                "KSP - Steam Controller"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Fusionner les actions",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/merge-actions.js",
            "args": [
                "KSP - Steam Controller"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
		{
            "type": "node",
            "request": "launch",
            "name": "Fusionner gordon",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/merge.js",
            "args": [
                "controller_steamcontroller_gordon"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
} 